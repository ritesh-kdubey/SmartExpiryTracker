<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F5E9">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="30dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_back_button"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="center"
                android:padding="9dp"
                android:contentDescription="Go Back"
                app:tint="#FFFFFF"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- OTP Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardOtp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="55dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/btnBack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">



                    <!-- Logo Section -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardOtpLogo"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginTop="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#E8F5E9">

                        <ImageView
                            android:id="@+id/ivOtpLogo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="18dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="OTP Logo" />

                    </androidx.cardview.widget.CardView>


                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvOtpTittle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Verify Your Email"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"
                        android:gravity="center"
                        app:layout_constraintTop_toBottomOf="@id/cardOtpLogo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="22dp" />

                    <!-- Description -->
                    <TextView
                        android:id="@+id/tvOtpDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Enter the 6-digit verification code sent to your email address."
                        android:textSize="14sp"
                        android:textColor="#616161"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tvOtpTittle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="12dp" />

                    <!-- OTP Input -->
                    <EditText
                        android:id="@+id/etOtpInput"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_marginTop="30dp"
                        android:background="@drawable/ettextbox"
                        android:hint="Enter 6-digit OTP"
                        android:inputType="number"
                        android:maxLength="6"
                        android:gravity="center"
                        android:letterSpacing="0.3"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"
                        android:textColorHint="#9E9E9E"
                        app:layout_constraintTop_toBottomOf="@id/tvOtpDescription"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Resend OTP -->
                    <LinearLayout
                        android:id="@+id/layoutResend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        app:layout_constraintTop_toBottomOf="@id/etOtpInput"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="22dp">

                        <TextView
                            android:id="@+id/tvDontReceiveOtp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Didn't receive the code?"
                            android:textSize="13sp"
                            android:textColor="#616161" />

                        <TextView
                            android:id="@+id/tvResend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Resend (00:30)"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- Verify Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerify"
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:text="Verify OTP"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#2E7D32"
                        app:layout_constraintTop_toBottomOf="@id/layoutResend"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="28dp" />

                    <!-- Back to Login -->
                    <TextView
                        android:id="@+id/tvBackToLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Back to Login"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_constraintTop_toBottomOf="@id/btnVerify"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="15dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Expiry Tracker"
                android:textSize="13sp"
                android:textColor="#558B58"
                app:layout_constraintTop_toBottomOf="@id/cardOtp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="20dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
