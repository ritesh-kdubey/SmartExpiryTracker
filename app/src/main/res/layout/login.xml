<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C8E6C9"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:layout_width="40dp"
        android:layout_height="60dp"
        android:text=" &lt;"
        android:textSize="90sp"
        android:gravity="center"
        android:foregroundGravity="right"
        android:fontFamily="sans-serif-light"
        android:background="@drawable/design_testing_purpose"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginStart="15dp">

    </TextView>

    <ImageView
        android:id="@+id/ivLoginLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="Login Logo"
        android:src="@color/primary_green"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp">

    </ImageView>

    <TextView
        android:id="@+id/tvLoginTittle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Expiry Tracker"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/ivLoginLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp">

    </TextView>

    <TextView
        android:id="@+id/tvLoginSubTittle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login to Your Account"
        android:textSize="18dp"
        android:fontFamily="sans-serif-light"
        app:layout_constraintTop_toBottomOf="@+id/tvLoginTittle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp">

    </TextView>

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textEmailAddress"
        android:hint="Email"
        android:background="@drawable/ettextbox"
        app:layout_constraintTop_toBottomOf="@+id/tvLoginSubTittle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="45dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp">

    </EditText>

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:inputType="textPassword"
        android:background="@drawable/ettextbox"
        app:layout_constraintTop_toBottomOf="@id/etEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp">

    </EditText>

    <CheckBox
        android:id="@+id/tvRememberPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remember Me"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toBottomOf="@+id/etPassword"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="15dp"
        android:layout_marginStart="20dp">

    </CheckBox>

    <TextView
        android:id="@+id/tvForgetPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forget Password?"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        app:layout_constraintTop_toBottomOf="@id/etPassword"
        app:layout_constraintEnd_toEndOf="@id/etPassword"
        app:layout_constraintStart_toEndOf="@id/tvRememberPassword"
        android:layout_marginTop="29dp"
        android:layout_marginLeft="120dp">

    </TextView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="  Login  "
        android:textSize="30sp"
        style="@style/PrimaryButton"
        app:layout_constraintTop_toBottomOf="@id/tvForgetPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="35dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp">

    </com.google.android.material.button.MaterialButton>

    <View
        android:id="@+id/vLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@id/btnLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp">

    </View>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Continue with google"
        android:textColor="@color/white"
        app:icon="@drawable/googleicon"
        style="@style/PrimaryButton"
        app:layout_constraintTop_toBottomOf="@+id/vLine"
        android:layout_marginTop="65dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp">

    </com.google.android.material.button.MaterialButton>

    <TextView
        android:id="@+id/tvDontHaveAnAcc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Don't have an account?"
        app:layout_constraintTop_toBottomOf="@id/btnLogin2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="50dp">


    </TextView>

    <TextView
        android:id="@+id/tvSignUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign Up"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        app:layout_constraintTop_toBottomOf="@id/btnLogin2"
        app:layout_constraintEnd_toEndOf="@id/btnLogin2"
        app:layout_constraintStart_toEndOf="@id/tvDontHaveAnAcc"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="70dp">
    </TextView>

</androidx.constraintlayout.widget.ConstraintLayout>