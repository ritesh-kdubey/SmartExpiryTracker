<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    tools:context=".AuthActivity">

    <View
        android:id="@+id/vLogoGlow"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/logo_glow"
        app:layout_constraintTop_toTopOf="@id/ivAppLogo"
        app:layout_constraintBottom_toBottomOf="@id/ivAppLogo"
        app:layout_constraintStart_toStartOf="@id/ivAppLogo"
        app:layout_constraintEnd_toEndOf="@id/ivAppLogo" />

    <ImageView
        android:id="@+id/ivAppLogo"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/splashscreenlogo"
        android:scaleType="fitCenter"
        android:contentDescription="App Logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvAppName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Expiry Tracker"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#263238"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/ivAppLogo"
        app:layout_constraintBottom_toTopOf="@id/tvTagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track it. Save it. Never waste it."
        android:textSize="14sp"
        android:textColor="#757575"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvAppName"
        app:layout_constraintBottom_toTopOf="@id/prLoadingBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="28dp" />

    <ProgressBar
        android:id="@+id/prLoadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="140dp"
        android:layout_height="5dp"
        android:max="100"
        android:progress="70"
        android:progressTint="#2E7D32"
        android:progressBackgroundTint="#DDEBDD"
        android:indeterminate="false"
        app:layout_constraintTop_toBottomOf="@id/tvTagline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
