<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8f8f8"
    tools:context=".AuthActivity">


    <View
        android:id="@+id/vLogoGlow"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:layout_constraintTop_toTopOf="@id/ivAppLogo"
        app:layout_constraintBottom_toBottomOf="@id/ivAppLogo"
        app:layout_constraintStart_toStartOf="@id/ivAppLogo"
        app:layout_constraintEnd_toEndOf="@id/ivAppLogo">

    </View>

    <ImageView
        android:id="@+id/ivAppLogo"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/splashscreenlogo"
        android:scaleType="centerInside"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="160dp">

    </ImageView>

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:text="Smart Expiry Tracker"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#263238"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivAppLogo">

    </TextView>

    <ProgressBar
        android:id="@+id/prLoadingBar"
        android:layout_width="15dp"
        android:layout_height="0dp"
        style="?android:attr/progressBarStyle"
        android:max="100"
        android:progressDrawable="@drawable/logo_glow"
        android:progress="70"
        android:indeterminate="false"
        android:progressTint="#2E7D32"
        app:layout_constraintTop_toBottomOf="@id/tvAppName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp">

    </ProgressBar>


</androidx.constraintlayout.widget.ConstraintLayout>